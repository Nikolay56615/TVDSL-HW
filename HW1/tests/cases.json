{
  "description": "mode=match: ВСЯ строка должна быть одним токеном, expect = имя правила или null (отвергнута). mode=lex: строка режется на токены, expect = список [вид, лексема]; WS и COMMENT не показываются, если нет keep_skipped. BAD_INT и ERROR - лексические ошибки.",
  "cases": [
    {"name": "пустая строка - не токен", "mode": "match", "input": "", "expect": null},
    {"name": "пустая строка - нет токенов", "mode": "lex", "input": "", "expect": []},

    {"name": "только пробелы", "mode": "lex", "input": "     ", "expect": []},
    {"name": "только табуляции", "mode": "lex", "input": "\t\t\t", "expect": []},
    {"name": "только CRLF", "mode": "lex", "input": "\r\n\r\n", "expect": []},
    {"name": "пробельные символы - один токен WS", "mode": "match", "input": " \t\r\n", "expect": "WS"},
    {"name": "пробельная строка целиком - один токен WS", "mode": "lex", "keep_skipped": true, "input": " \t\r\n ", "expect": [["WS", " \t\r\n "]]},
    {"name": "form feed - не пробел", "mode": "lex", "input": "a\u000cb", "expect": [["IDENT", "a"], ["ERROR", "\u000c"], ["IDENT", "b"]]},

    {"name": "INT 0", "mode": "match", "input": "0", "expect": "INT"},
    {"name": "INT 42", "mode": "match", "input": "42", "expect": "INT"},
    {"name": "INT с нулями внутри", "mode": "match", "input": "1002003000", "expect": "INT"},
    {"name": "отрицательный: 00", "mode": "match", "input": "00", "expect": "BAD_INT"},
    {"name": "отрицательный: 01", "mode": "match", "input": "01", "expect": "BAD_INT"},
    {"name": "отрицательный: 007", "mode": "match", "input": "007", "expect": "BAD_INT"},
    {"name": "отрицательный: 12a - не один токен", "mode": "match", "input": "12a", "expect": null},
    {"name": "отрицательный: знак не входит в INT", "mode": "match", "input": "-1", "expect": null},
    {"name": "lex: 01 - одна ошибка, а не два INT", "mode": "lex", "input": "01", "expect": [["BAD_INT", "01"]]},
    {"name": "lex: 0 0 - два INT", "mode": "lex", "input": "0 0", "expect": [["INT", "0"], ["INT", "0"]]},
    {"name": "lex: число, приклеенное к слову", "mode": "lex", "input": "12abc", "expect": [["INT", "12"], ["IDENT", "abc"]]},
    {"name": "lex: -42 - это MINUS INT", "mode": "lex", "input": "-42", "expect": [["MINUS", "-"], ["INT", "42"]]},

    {"name": "IDENT из одной буквы", "mode": "match", "input": "x", "expect": "IDENT"},
    {"name": "IDENT из одного подчёркивания", "mode": "match", "input": "_", "expect": "IDENT"},
    {"name": "IDENT с подчёркиванием в начале", "mode": "match", "input": "_tmp", "expect": "IDENT"},
    {"name": "IDENT с подчёркиваниями и цифрами", "mode": "match", "input": "is_sorted_2", "expect": "IDENT"},
    {"name": "IDENT в верхнем регистре", "mode": "match", "input": "CamelCase", "expect": "IDENT"},
    {"name": "отрицательный: IDENT не начинается с цифры", "mode": "match", "input": "1abc", "expect": null},
    {"name": "отрицательный: в IDENT нет дефиса", "mode": "match", "input": "a-b", "expect": null},

    {"name": "ключевое слово function", "mode": "match", "input": "function", "expect": "FUNCTION"},
    {"name": "ключевое слово returns", "mode": "match", "input": "returns", "expect": "RETURNS"},
    {"name": "ключевое слово requires", "mode": "match", "input": "requires", "expect": "REQUIRES"},
    {"name": "ключевое слово ensures", "mode": "match", "input": "ensures", "expect": "ENSURES"},
    {"name": "ключевое слово uses", "mode": "match", "input": "uses", "expect": "USES"},
    {"name": "ключевое слово if", "mode": "match", "input": "if", "expect": "IF"},
    {"name": "ключевое слово else", "mode": "match", "input": "else", "expect": "ELSE"},
    {"name": "ключевое слово while", "mode": "match", "input": "while", "expect": "WHILE"},
    {"name": "ключевое слово invariant", "mode": "match", "input": "invariant", "expect": "INVARIANT"},
    {"name": "ключевое слово assert", "mode": "match", "input": "assert", "expect": "ASSERT"},
    {"name": "ключевое слово assume", "mode": "match", "input": "assume", "expect": "ASSUME"},
    {"name": "ключевое слово true", "mode": "match", "input": "true", "expect": "TRUE"},
    {"name": "ключевое слово false", "mode": "match", "input": "false", "expect": "FALSE"},
    {"name": "ключевое слово not", "mode": "match", "input": "not", "expect": "NOT"},
    {"name": "ключевое слово and", "mode": "match", "input": "and", "expect": "AND"},
    {"name": "ключевое слово or", "mode": "match", "input": "or", "expect": "OR"},
    {"name": "ключевое слово forall", "mode": "match", "input": "forall", "expect": "FORALL"},
    {"name": "ключевое слово exists", "mode": "match", "input": "exists", "expect": "EXISTS"},
    {"name": "ключевое слово int", "mode": "match", "input": "int", "expect": "TYPE_INT"},
    {"name": "ключевое слово length", "mode": "match", "input": "length", "expect": "LENGTH"},
    {"name": "почти ключевое слово: functions - IDENT", "mode": "match", "input": "functions", "expect": "IDENT"},
    {"name": "почти ключевое слово: functio - IDENT", "mode": "match", "input": "functio", "expect": "IDENT"},
    {"name": "почти ключевое слово: iff - IDENT", "mode": "match", "input": "iff", "expect": "IDENT"},
    {"name": "регистр важен: If - IDENT", "mode": "match", "input": "If", "expect": "IDENT"},
    {"name": "ключевые слова с общим началом", "mode": "lex", "input": "assert assume assu if int invariant in", "expect": [["ASSERT", "assert"], ["ASSUME", "assume"], ["IDENT", "assu"], ["IF", "if"], ["TYPE_INT", "int"], ["INVARIANT", "invariant"], ["IDENT", "in"]]},

    {"name": "оператор +", "mode": "match", "input": "+", "expect": "PLUS"},
    {"name": "оператор -", "mode": "match", "input": "-", "expect": "MINUS"},
    {"name": "оператор *", "mode": "match", "input": "*", "expect": "STAR"},
    {"name": "оператор /", "mode": "match", "input": "/", "expect": "SLASH"},
    {"name": "оператор ==", "mode": "match", "input": "==", "expect": "EQ"},
    {"name": "оператор !=", "mode": "match", "input": "!=", "expect": "NE"},
    {"name": "оператор <=", "mode": "match", "input": "<=", "expect": "LE"},
    {"name": "оператор >=", "mode": "match", "input": ">=", "expect": "GE"},
    {"name": "оператор <", "mode": "match", "input": "<", "expect": "LT"},
    {"name": "оператор >", "mode": "match", "input": ">", "expect": "GT"},
    {"name": "оператор =", "mode": "match", "input": "=", "expect": "ASSIGN"},
    {"name": "оператор ->", "mode": "match", "input": "->", "expect": "ARROW"},
    {"name": "оператор =>", "mode": "match", "input": "=>", "expect": "FATARROW"},
    {"name": "отрицательный: одинокий ! - не токен", "mode": "match", "input": "!", "expect": null},
    {"name": "отрицательный: === - не один токен", "mode": "match", "input": "===", "expect": null},
    {"name": "разделители подряд", "mode": "lex", "input": "()[]{},;:|", "expect": [["LPAREN", "("], ["RPAREN", ")"], ["LBRACKET", "["], ["RBRACKET", "]"], ["LBRACE", "{"], ["RBRACE", "}"], ["COMMA", ","], ["SEMI", ";"], ["COLON", ":"], ["BAR", "|"]]},
    {"name": "самое длинное совпадение: === это EQ ASSIGN", "mode": "lex", "input": "===", "expect": [["EQ", "=="], ["ASSIGN", "="]]},
    {"name": "самое длинное совпадение: <== это LE ASSIGN", "mode": "lex", "input": "<==", "expect": [["LE", "<="], ["ASSIGN", "="]]},
    {"name": "самое длинное совпадение: <=> это LE GT", "mode": "lex", "input": "<=>", "expect": [["LE", "<="], ["GT", ">"]]},
    {"name": "самое длинное совпадение: --> это MINUS ARROW", "mode": "lex", "input": "-->", "expect": [["MINUS", "-"], ["ARROW", "->"]]},
    {"name": "=< это ASSIGN LT", "mode": "lex", "input": "=<", "expect": [["ASSIGN", "="], ["LT", "<"]]},
    {"name": "пробел разделяет операторы", "mode": "lex", "input": "= =", "expect": [["ASSIGN", "="], ["ASSIGN", "="]]},
    {"name": "одинокий ! - ошибка, остальное живо", "mode": "lex", "input": "a ! b", "expect": [["IDENT", "a"], ["ERROR", "!"], ["IDENT", "b"]]},
    {"name": "выражение без пробелов", "mode": "lex", "input": "1+2*3-4/5", "expect": [["INT", "1"], ["PLUS", "+"], ["INT", "2"], ["STAR", "*"], ["INT", "3"], ["MINUS", "-"], ["INT", "4"], ["SLASH", "/"], ["INT", "5"]]},

    {"name": "комментарий - один токен COMMENT", "mode": "match", "input": "// any text == 01 @ here", "expect": "COMMENT"},
    {"name": "пустой комментарий", "mode": "match", "input": "//", "expect": "COMMENT"},
    {"name": "отрицательный: перевод строки не входит в комментарий", "mode": "match", "input": "// text\n", "expect": null},
    {"name": "комментарий до конца файла", "mode": "lex", "input": "x // trailing", "expect": [["IDENT", "x"]]},
    {"name": "комментарий кончается на LF", "mode": "lex", "input": "x // c\ny", "expect": [["IDENT", "x"], ["IDENT", "y"]]},
    {"name": "комментарий кончается перед CRLF", "mode": "lex", "keep_skipped": true, "input": "//c\r\n1", "expect": [["COMMENT", "//c"], ["WS", "\r\n"], ["INT", "1"]]},
    {"name": "комментарий скрывает всё, включая мусор", "mode": "lex", "input": "a // if == 01 @ $\nb", "expect": [["IDENT", "a"], ["IDENT", "b"]]},
    {"name": "одиночный / - деление", "mode": "lex", "input": "a / b", "expect": [["IDENT", "a"], ["SLASH", "/"], ["IDENT", "b"]]},
    {"name": "деление вплотную к комментарию", "mode": "lex", "keep_skipped": true, "input": "a/b//c", "expect": [["IDENT", "a"], ["SLASH", "/"], ["IDENT", "b"], ["COMMENT", "//c"]]},

    {"name": "неизвестный символ @", "mode": "lex", "input": "foo @ 42", "expect": [["IDENT", "foo"], ["ERROR", "@"], ["INT", "42"]]},
    {"name": "соседние неизвестные символы - одна ошибка", "mode": "lex", "input": "a @#$ b", "expect": [["IDENT", "a"], ["ERROR", "@#$"], ["IDENT", "b"]]},
    {"name": "кавычки, точка, обратная косая - не в языке", "mode": "lex", "input": "a.b \"s\"", "expect": [["IDENT", "a"], ["ERROR", "."], ["IDENT", "b"], ["ERROR", "\""], ["IDENT", "s"], ["ERROR", "\""]]},
    {"name": "символ NUL уходит в ловушку", "mode": "match", "input": "\u0000", "expect": null},
    {"name": "символ DEL уходит в ловушку", "mode": "match", "input": "\u007f", "expect": null},

    {"name": "не-ASCII: буква с диакритикой", "mode": "match", "input": "é", "expect": null},
    {"name": "не-ASCII: первый код после ASCII (U+0080)", "mode": "match", "input": "\u0080", "expect": null},
    {"name": "не-ASCII: русское слово - одна ошибка", "mode": "lex", "input": "x = привет;", "expect": [["IDENT", "x"], ["ASSIGN", "="], ["ERROR", "привет"], ["SEMI", ";"]]},
    {"name": "не-ASCII: русская 'а' внутри идентификатора", "mode": "lex", "input": "vаr", "expect": [["IDENT", "v"], ["ERROR", "а"], ["IDENT", "r"]]},
    {"name": "не-ASCII: стрелка → - не ARROW", "mode": "lex", "input": "a → b", "expect": [["IDENT", "a"], ["ERROR", "→"], ["IDENT", "b"]]},
    {"name": "не-ASCII: эмодзи вне BMP", "mode": "lex", "input": "1 😀 2", "expect": [["INT", "1"], ["ERROR", "😀"], ["INT", "2"]]},
    {"name": "не-ASCII: даже внутри комментария (алфавит - ASCII)", "mode": "lex", "keep_skipped": true, "input": "// ок\nx", "expect": [["COMMENT", "// "], ["ERROR", "ок"], ["WS", "\n"], ["IDENT", "x"]]},

    {"name": "программа: пример из практики P02", "mode": "lex", "input": "function add(x,y) returns r { r = x + y; // sum\n}", "expect": [["FUNCTION", "function"], ["IDENT", "add"], ["LPAREN", "("], ["IDENT", "x"], ["COMMA", ","], ["IDENT", "y"], ["RPAREN", ")"], ["RETURNS", "returns"], ["IDENT", "r"], ["LBRACE", "{"], ["IDENT", "r"], ["ASSIGN", "="], ["IDENT", "x"], ["PLUS", "+"], ["IDENT", "y"], ["SEMI", ";"], ["RBRACE", "}"]]},
    {"name": "программа: контракт функции (пример проекта step09)", "mode": "lex", "input": "incpos(x:int) requires x >= 0 returns y:int ensures y > x {\r\n    y = x + 1;\r\n}\r\n", "expect": [["IDENT", "incpos"], ["LPAREN", "("], ["IDENT", "x"], ["COLON", ":"], ["TYPE_INT", "int"], ["RPAREN", ")"], ["REQUIRES", "requires"], ["IDENT", "x"], ["GE", ">="], ["INT", "0"], ["RETURNS", "returns"], ["IDENT", "y"], ["COLON", ":"], ["TYPE_INT", "int"], ["ENSURES", "ensures"], ["IDENT", "y"], ["GT", ">"], ["IDENT", "x"], ["LBRACE", "{"], ["IDENT", "y"], ["ASSIGN", "="], ["IDENT", "x"], ["PLUS", "+"], ["INT", "1"], ["SEMI", ";"], ["RBRACE", "}"]]},
    {"name": "программа: цикл с инвариантом (пример проекта step10)", "mode": "lex", "input": "while (i < n)\n    invariant 0 <= i and r == i * (i - 1) / 2\n{ i = i + 1; }", "expect": [["WHILE", "while"], ["LPAREN", "("], ["IDENT", "i"], ["LT", "<"], ["IDENT", "n"], ["RPAREN", ")"], ["INVARIANT", "invariant"], ["INT", "0"], ["LE", "<="], ["IDENT", "i"], ["AND", "and"], ["IDENT", "r"], ["EQ", "=="], ["IDENT", "i"], ["STAR", "*"], ["LPAREN", "("], ["IDENT", "i"], ["MINUS", "-"], ["INT", "1"], ["RPAREN", ")"], ["SLASH", "/"], ["INT", "2"], ["LBRACE", "{"], ["IDENT", "i"], ["ASSIGN", "="], ["IDENT", "i"], ["PLUS", "+"], ["INT", "1"], ["SEMI", ";"], ["RBRACE", "}"]]},
    {"name": "программа: формула с квантором и импликацией", "mode": "lex", "input": "sorted(a:int[]) => forall (k:int | k >= 0 -> a[k] <= a[k + 1]);", "expect": [["IDENT", "sorted"], ["LPAREN", "("], ["IDENT", "a"], ["COLON", ":"], ["TYPE_INT", "int"], ["LBRACKET", "["], ["RBRACKET", "]"], ["RPAREN", ")"], ["FATARROW", "=>"], ["FORALL", "forall"], ["LPAREN", "("], ["IDENT", "k"], ["COLON", ":"], ["TYPE_INT", "int"], ["BAR", "|"], ["IDENT", "k"], ["GE", ">="], ["INT", "0"], ["ARROW", "->"], ["IDENT", "a"], ["LBRACKET", "["], ["IDENT", "k"], ["RBRACKET", "]"], ["LE", "<="], ["IDENT", "a"], ["LBRACKET", "["], ["IDENT", "k"], ["PLUS", "+"], ["INT", "1"], ["RBRACKET", "]"], ["RPAREN", ")"], ["SEMI", ";"]]},
    {"name": "программа: ошибки не останавливают сканер", "mode": "lex", "input": "r = 007 + x$y;", "expect": [["IDENT", "r"], ["ASSIGN", "="], ["BAD_INT", "007"], ["PLUS", "+"], ["IDENT", "x"], ["ERROR", "$"], ["IDENT", "y"], ["SEMI", ";"]]}
  ]
}
