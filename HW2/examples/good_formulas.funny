// Формула: отсортирован на отрезке [l, r]
is_sorted(a:int[], l:int, r:int) =>
    forall (k:int | (l <= k and k + 1 <= r) → a[k] <= a[k + 1]);

check_sorted(a:int[]) requires length(a) > 1 returns ok:int {
    ok = 1;
    i = 1;
    while (i < length(a)) {
        if (a[i - 1] > a[i]) ok = 0;
        i = i + 1;
    }
    assert is_sorted(a, 0, length(a) - 1);
}
