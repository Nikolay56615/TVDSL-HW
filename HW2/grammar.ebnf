(* IDENT/INT и ключевые слова берутся из HW1.
   EBNF: [...] — необязательная часть; {...} — повторение; | — альтернативы.
   Комментарии и пробельные символы пропускаются; модуль должен содержать объявление.
   Грамматика выражений приведена к общей форме для скобок в арифметике и предикатах.
   Приведённые ниже ограничения на категории проверяются после построения выражения.
   Возврат к предыдущим вариантам разбора и пробный повторный разбор не используются.
*)

module          = declaration { declaration } EOF ;
declaration     = [ "function" ] IDENT "(" [ parameters ] ")" declarationTail ;
declarationTail = "=>" predicate [ ";" ]
                | [ "requires" predicate ] "returns" results
                  [ "requires" predicate ] [ "ensures" predicate ]
                  [ "uses" locals ] statement ;
(* "function" допустимо только перед функциями; requires встречается не более одного раза.
   Предпочтительный порядок — requires перед returns, как в funny.ru.md.
   requires после returns допускается для совместимости с учебными примерами.
*)

parameters      = variableDef { "," variableDef } ;
results         = variableDef { "," variableDef } ;
variableDef     = IDENT ":" variableType ;
variableType    = "int" [ "[" "]" ] ;
locals          = localDef { "," localDef } ;
localDef        = IDENT [ ":" variableType ] ;

statement       = assignment | conditional | loop | block
                | "assert" predicate ";" | "assume" predicate ";" ;
block           = "{" { statement } "}" ;
assignment      = IDENT assignmentTail ;
assignmentTail  = { "[" arithmetic "]" } "=" arithmetic ";"
                | "," IDENT { "," IDENT } "=" arithmetic ";" ;
conditional     = "if" "(" condition ")" statement [ "else" statement ] ;
loop            = "while" "(" condition ")" [ "invariant" predicate ] statement ;
(* else относится к ближайшему if без ветки else. Необязательная ветка else создаёт
   конфликт FIRST/FOLLOW; парсер разрешает его, сразу принимая встретившийся else.
   Поэтому полная грамматика операторов не считается строго LL(1).
*)

arithmetic      = expression ;
condition       = expression ;
predicate       = expression ;
expression      = implication ;
implication     = disjunction [ ("->" | "→") implication ] ;
disjunction     = conjunction { "or" conjunction } ;
conjunction     = negation { "and" negation } ;
negation        = "not" negation | comparison ;
comparison      = addition [ comparisonOp addition ] ;
comparisonOp    = "==" | "!=" | "<=" | ">=" | "<" | ">" ;
addition        = multiplication { ("+" | "-") multiplication } ;
multiplication  = unary { ("*" | "/") unary } ;
unary           = "-" unary | primary ;
primary         = INT | "true" | "false" | quantifier
                | "(" expression ")" | IDENT identifierTail | lengthCall ;
identifierTail  = "(" [ arguments ] ")" | { "[" arithmetic "]" } ;
lengthCall      = "length" "(" [ arguments ] ")" ;
arguments       = arithmetic { "," arithmetic } ;
quantifier      = ("forall" | "exists") "(" variableDef "|" predicate ")" ;

(* Ограничения на категории до анализа имён и типов (HW3):
   - Арифметика: только INT, Name, Call, Index, унарный -, бинарные + - * /.
   - Логические выражения: Bool, сравнение арифметических выражений, not/and/or/->,
     вызов формулы Call и (только в предикатах) forall/exists.
   - Обычная арифметика не является условием или предикатом. length допустимо только в арифметике.
   - Вызовы в исполняемых условиях запрещены: ссылки на формулы относятся к предикатам.
   - Аргументы и индексы — арифметические выражения; цепочки сравнений запрещены.
   - У множественного присваивания слева только узлы Name, справа — Call;
     скобки вокруг Call допускаются, например x,y=(f()).
   - Цепочки индексов после Name допускаются как синтаксический сахар для вложенных обновлений.
   - Необязательный контракт означает отсутствие раздела, а не пустое выражение после ключевого слова.
   - По умолчанию requires равно true, ensures — false, invariant — true.
   - Присваивание элементу массива преобразуется в функциональный ArrayUpdate внутри Assign.
   - + - * / and/or левоассоциативны; -> правоассоциативна; сравнения неассоциативны.
   - Приоритет от высшего к низшему: унарный -, * /, + -, сравнение, not, and, or, ->.
   - Объявляются только типы int/int[]; оператора var и логических переменных нет.
   - Подчёркивания в идентификаторах соответствуют правилам HW1. Идентификаторы используют ASCII.
     Импликация допускает -> и →; в AST оператор нормализуется к ->.
     Остальные символы Unicode допустимы только в пропускаемых комментариях.
*)
