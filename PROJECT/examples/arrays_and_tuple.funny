minmax(a:int[]) requires length(a) > 0 returns low:int, high:int uses i {
    low = a[0];
    high = a[0];
    i = 1;
    while (i < length(a)) {
        if (a[i] < low) low = a[i];
        if (a[i] > high) high = a[i];
        i = i + 1;
    }
}

normalize(a:int[]) requires length(a) >= 2 returns result:int[], span:int uses low, high {
    result = a;
    low, high = minmax(result);
    result[0] = low;
    result[1] = high;
    span = high - low;
}

main(a:int[]) returns result:int[], span:int {
    result, span = normalize(a);
}
