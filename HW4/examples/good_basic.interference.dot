graph "interference_main" {
  node [shape=ellipse, fontname="monospace"];
  "t:10" [label="t:10 [color=0]", style="filled", fillcolor="#cce5ff"];
  "t:6" [label="t:6 [color=0]", style="filled", fillcolor="#cce5ff"];
  "t:8" [label="t:8 [color=0]", style="filled", fillcolor="#cce5ff"];
  "v:r" [label="v:r [color=0]", style="filled", fillcolor="#cce5ff"];
  "v:x" [label="v:x [color=0]", style="filled", fillcolor="#cce5ff"];
}
